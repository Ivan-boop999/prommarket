generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  displayName         String?              @map("display_name")
  role                UserRole             @default(user)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  avatars             UserAvatar[]
  vendor              Vendor?
  buyer               Buyer?
  dealsAsBroker       Deal[]               @relation("DealBroker")
  brokerFees          BrokerFeeLedger[]
  verificationReviews VerificationRequest[] @relation("VerificationReviewer")
  paymentConfirmations Invoice[]           @relation("InvoiceConfirmer")
  reviews             ProductReview[]
  notifications       Notification[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

/// One row per avatar upload attempt. The object itself lives in private storage; this table
/// owns who it belongs to and whether it is finished, because storage cannot answer either.
model UserAvatar {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  state       UserAvatarState @default(pending)
  /// Backend-generated and PII-free; see backend/src/storage/object-keys.ts.
  objectKey   String          @unique(map: "user_avatars_object_key_key") @map("object_key")
  contentType String          @map("content_type")
  byteSize    Int             @map("byte_size")
  /// When the signed upload URL stops working, which is also when a pending row becomes junk.
  expiresAt   DateTime        @map("expires_at")
  readyAt     DateTime?       @map("ready_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_avatars_user_id_fkey")

  /// The product rule as a database constraint: at most one upload in flight and at most one
  /// live avatar per user, so a lost race fails loudly instead of leaving two live avatars.
  @@unique([userId, state], map: "user_avatars_user_id_state_key")
  @@index([state, expiresAt], map: "user_avatars_state_expires_at_idx")
  @@map("user_avatars")
}

enum UserAvatarState {
  pending
  ready

  @@map("user_avatar_state")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@index([userId, createdAt], map: "password_reset_tokens_user_id_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

enum UserRole {
  user
  admin
  vendor
  broker
  buyer
  moderator

  @@map("user_role")
}

// =============================================================================
// TASK OUTBOX
//
// Durable background work. Keep this block contiguous: the `mobile` branch keeps
// its schema in `prisma/schema/`, so merging means moving these two declarations
// into `prisma/schema/outbox.prisma` unchanged.
// =============================================================================

/// Work that must survive a process restart. `background-tasks.ts` defers work whose loss is
/// acceptable; this table is for work whose loss is not. Rows are claimed and run by the
/// `outbox:drain` job - see docs/BACKGROUND_JOBS.md.
model TaskOutbox {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Validated in code against the handler registry, not by a database enum, so adding a task
  /// type stays a code change. See backend/src/outbox/handlers.ts.
  type            String
  /// The idempotency boundary. The caller chooses how wide the window is by what it puts here.
  dedupeKey       String           @map("dedupe_key")
  /// Blanked to `{}` once the task reaches a terminal status; the row itself is kept for audit.
  payload         Json
  status          TaskOutboxStatus @default(pending)
  /// Due time. Retries move it into the future; a recovered lease moves it back to now.
  scheduledFor    DateTime         @default(now()) @map("scheduled_for")
  attempts        Int              @default(0)
  lastError       String?          @map("last_error")
  /// Fencing token held by the process currently running this row. Every write after the claim
  /// re-asserts it, so a process that lost its lease cannot overwrite the winner's result.
  processingToken String?          @map("processing_token") @db.Uuid
  processedAt     DateTime?        @map("processed_at")
  redactedAt      DateTime?        @map("redacted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  /// Doubles as the lease clock: Prisma bumps it on the claiming `updateMany`, and a row whose
  /// lease went stale is requeued with `attempts` untouched.
  updatedAt       DateTime         @updatedAt @map("updated_at")

  /// No user relation on purpose: a generic outbox must not lose queued work when a user row
  /// goes away, and a task may be keyed on something that is not a user at all. A task that
  /// needs a user id carries it in the payload.
  @@unique([type, dedupeKey], map: "task_outbox_type_dedupe_key_key")
  @@index([status, scheduledFor], map: "task_outbox_status_scheduled_for_idx")
  @@index([status, processedAt], map: "task_outbox_status_processed_at_idx")
  @@map("task_outbox")
}

/// `skipped` is not needed for correctness. It exists so that a system where every task
/// deliberately does nothing looks different from a healthy one in the drain metrics.
enum TaskOutboxStatus {
  pending
  processing
  done
  skipped
  failed

  @@map("task_outbox_status")
}

model AuthSession {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  refreshTokenFamilyHash   String?   @unique(map: "auth_sessions_refresh_token_family_hash_key") @map("refresh_token_family_hash")
  previousRefreshTokenHash String?   @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime? @map("refresh_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

// =============================================================================
// MARKETPLACE (ПромМаркет port)
//
// Adapted from the original Next.js/SQLite schema to PostgreSQL + vibe
// conventions: UUIDv7 PKs, snake_case column names via @map, real enums,
// Json for EAV values and SELECT options (the original stored both as
// JSON-in-a-String, which was lossy and un-queryable).
// =============================================================================

// --- CATEGORIES (tree, unlimited depth) ---

model Category {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  slug         String              @unique(map: "categories_slug_key")
  description  String?
  parentId     String?             @map("parent_id") @db.Uuid
  order        Int                 @default(0)
  icon         String?
  image        String?
  /// Denormalized counter; maintained by application code, not a DB trigger.
  productCount Int                 @default(0) @map("product_count")
  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, map: "categories_parent_id_fkey")
  children     Category[]          @relation("CategoryTree")
  attributes   CategoryAttribute[]
  products     Product[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([parentId], map: "categories_parent_id_idx")
  @@map("categories")
}

// --- EAV ATTRIBUTES ---

model Attribute {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  slug         String              @unique(map: "attributes_slug_key")
  description  String?
  type         AttributeType       @default(text)
  unit         String?
  /// JSON array of option strings for SELECT / MULTI_SELECT. Null for other types.
  options      Json?
  isFilterable Boolean             @default(false) @map("is_filterable")
  isRequired   Boolean             @default(false) @map("is_required")
  order        Int                 @default(0)
  categories   CategoryAttribute[]
  values       ProductAttribute[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("attributes")
}

/// @map to lowercase values because PostgreSQL enums are case-sensitive and the
/// template's existing enums (user_role, task_outbox_status) all use lowercase.
enum AttributeType {
  text
  number
  number_range
  select
  multi_select
  boolean
  file
  dimensions

  @@map("attribute_type")
}

/// Category-Attribute junction. `inherited` flags values taken from a parent
/// category; not auto-populated today but kept for future inheritance work.
model CategoryAttribute {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  inherited   Boolean   @default(false)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "category_attributes_category_id_fkey")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, map: "category_attributes_attribute_id_fkey")

  @@unique([categoryId, attributeId], map: "category_attributes_category_id_attribute_id_key")
  @@index([attributeId], map: "category_attributes_attribute_id_idx")
  @@map("category_attributes")
}

// --- PRODUCTS ---

model Product {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title         String
  slug          String              @unique(map: "products_slug_key")
  description   String?
  sku           String?
  oemNumber     String?             @map("oem_number")
  brand         String?
  model         String?
  year          Int?
  status        ProductStatus       @default(new)
  availability  ProductAvailability @default(in_stock)
  /// Human-readable lead time, e.g. "2-3 недели".
  /// Denormalized: latest active featured placement end. Maintained by the billing module
  /// when an invoice for a featured placement is confirmed, so the catalog query can filter
  /// and boost featured products without joining featured_placements.
  featuredUntil DateTime?           @map("featured_until")
  leadTime      String?             @map("lead_time")
  conditionNote String?             @map("condition_note")
  categoryId    String              @map("category_id") @db.Uuid
  vendorId      String              @map("vendor_id") @db.Uuid
  views         Int                 @default(0)
  category      Category            @relation(fields: [categoryId], references: [id], map: "products_category_id_fkey")
  vendor        Vendor              @relation(fields: [vendorId], references: [id], map: "products_vendor_id_fkey")
  images        ProductImage[]
  attributes    ProductAttribute[]
  prices        ProductPrice[]
  deals         Deal[]
  featuredPlacements FeaturedPlacement[]
  reviews       ProductReview[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([categoryId], map: "products_category_id_idx")
  @@index([vendorId], map: "products_vendor_id_idx")
  @@index([status], map: "products_status_idx")
  @@map("products")
}

enum ProductStatus {
  new
  used
  refurbished
  spare_parts
  storage

  @@map("product_status")
}

enum ProductAvailability {
  in_stock
  on_order

  @@map("product_availability")
}

/// EAV value. Stored as Json so NUMBER / NUMBER_RANGE / MULTI_SELECT / DIMENSIONS
/// stay structured and queryable, fixing the original's lossy String column.
model ProductAttribute {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  /// Structured value. Shape depends on Attribute.type: scalar for text/number/boolean,
  /// array for multi_select, {min,max} for number_range, {l,w,h} for dimensions.
  value       Json
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_attributes_product_id_fkey")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, map: "product_attributes_attribute_id_fkey")

  @@unique([productId, attributeId], map: "product_attributes_product_id_attribute_id_key")
  @@index([attributeId], map: "product_attributes_attribute_id_idx")
  @@map("product_attributes")
}

model ProductImage {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// URL or object key. Resolves through the storage layer when served.
  url       String
  alt       String?
  order     Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_images_product_id_fkey")

  @@index([productId], map: "product_images_product_id_idx")
  @@map("product_images")
}

/// One product has 1..N price rows: a FIXED main price, optional VOLUME tiers,
/// or ON_REQUEST (price hidden). VAT metadata is per-row.
model ProductPrice {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        PriceType @default(fixed)
  /// Decimal currency; Float is wrong for money.
  price       Decimal?  @db.Decimal(14, 2)
  currency    String    @default("RUB")
  includesVat Boolean   @default(true) @map("includes_vat")
  vatRate     Int       @default(20) @map("vat_rate")
  /// Null upper bound means "and above".
  volumeFrom  Int?      @map("volume_from")
  volumeTo    Int?      @map("volume_to")
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_prices_product_id_fkey")

  @@index([productId], map: "product_prices_product_id_idx")
  @@index([type], map: "product_prices_type_idx")
  @@map("product_prices")
}

enum PriceType {
  fixed
  on_request
  volume

  @@map("price_type")
}

// --- VENDORS (sellers) ---

/// 1:1 with User. A user with role `vendor` has exactly one Vendor profile.
model Vendor {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Link to the auth user. One vendor profile per user.
  userId       String    @unique(map: "vendors_user_id_key") @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "vendors_user_id_fkey")
  companyName  String    @map("company_name")
  inn          String    @unique(map: "vendors_inn_key")
  ogrn         String?
  description  String?
  logo         String?
  /// Denormalized: true when verificationTier != none. Kept for cheap catalog filtering;
  /// the source of truth is the latest approved VerificationRequest.
  verified     Boolean   @default(false)
  /// Verification tier granted by an approved VerificationRequest. Drives the badge variant
  /// shown in the catalog and the "verified supplier" filter.
  verificationTier VerificationTier @default(none) @map("verification_tier")
  rating       Decimal   @default(0) @db.Decimal(3, 2)
  totalDeals   Int       @default(0) @map("total_deals")
  contactName  String?   @map("contact_name")
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  website      String?
  address      String?
  city         String?
  products     Product[]
  deals        Deal[]
  subscriptions VendorSubscription[]
  leadCreditLedger LeadCreditLedger[]
  verificationRequests VerificationRequest[]
  addOns       VendorAddOn[]
  featuredPlacements FeaturedPlacement[]
  invoices     Invoice[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([verified], map: "vendors_verified_idx")
  @@index([verificationTier], map: "vendors_verification_tier_idx")
  @@map("vendors")
}

enum VerificationTier {
  none
  basic
  pro

  @@map("verification_tier")
}

// --- BUYERS ---

/// 1:1 with User. A user with role `buyer` has exactly one Buyer profile.
model Buyer {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @unique(map: "buyers_user_id_key") @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "buyers_user_id_fkey")
  companyName  String   @map("company_name")
  inn          String   @unique(map: "buyers_inn_key")
  ogrn         String?
  contactName  String?  @map("contact_name")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  address      String?
  city         String?
  deals        Deal[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("buyers")
}

// --- DEALS (broker pipeline) ---

model Deal {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Human-readable number, e.g. SD-2026-0001. Generated from a DB sequence,
  /// not max+1, to avoid the original's race condition.
  dealNumber      String        @unique(map: "deals_deal_number_key") @map("deal_number")
  type            DealType
  status          DealStatus    @default(new)
  title           String
  description     String?
  productId       String?       @map("product_id") @db.Uuid
  buyerId         String?       @map("buyer_id") @db.Uuid
  vendorId        String?       @map("vendor_id") @db.Uuid
  /// Broker is a User (role broker). In the original this field existed but was
  /// never populated; here it is a real FK.
  brokerId        String?       @map("broker_id") @db.Uuid
  quantity        Int?
  deliveryDate    DateTime?     @map("delivery_date")
  deliveryAddress String?       @map("delivery_address")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(16, 2)
  currency        String        @default("RUB")
  commission      Decimal?      @db.Decimal(16, 2)
  notes           String?
  product         Product?      @relation(fields: [productId], references: [id], map: "deals_product_id_fkey")
  buyer           Buyer?        @relation(fields: [buyerId], references: [id], map: "deals_buyer_id_fkey")
  vendor          Vendor?       @relation(fields: [vendorId], references: [id], map: "deals_vendor_id_fkey")
  broker          User?         @relation("DealBroker", fields: [brokerId], references: [id], map: "deals_broker_id_fkey")
  messages        DealMessage[]
  history         DealHistory[]
  brokerFees      BrokerFeeLedger[]
  invoices        Invoice[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status], map: "deals_status_idx")
  @@index([vendorId], map: "deals_vendor_id_idx")
  @@index([buyerId], map: "deals_buyer_id_idx")
  @@index([brokerId], map: "deals_broker_id_idx")
  @@index([dealNumber], map: "deals_deal_number_idx")
  @@map("deals")
}

enum DealType {
  rfq
  specification
  price_proposal
  procurement

  @@map("deal_type")
}

enum DealStatus {
  new
  verification
  negotiation
  proposal
  connection
  completed
  cancelled

  @@map("deal_status")
}

/// Persisted deal chat messages. The original kept these in-memory only; this
/// table is what makes the chat survive a restart.
model DealMessage {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dealId     String      @map("deal_id") @db.Uuid
  /// The User who sent it.
  senderId   String      @map("sender_id") @db.Uuid
  senderRole MessageRole @map("sender_role")
  content    String
  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade, map: "deal_messages_deal_id_fkey")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([dealId, createdAt], map: "deal_messages_deal_id_created_at_idx")
  @@map("deal_messages")
}

enum MessageRole {
  broker
  vendor
  buyer

  @@map("message_role")
}

/// Deal audit trail. `action` is free-form but conventionally CREATED /
/// STATUS_CHANGE / MESSAGE / etc.
model DealHistory {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  action    String
  userId    String?  @map("user_id") @db.Uuid
  details   String?
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade, map: "deal_history_deal_id_fkey")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([dealId, createdAt], map: "deal_history_deal_id_created_at_idx")
  @@map("deal_history")
}

/// Monotonic counter for deal numbers. One row per year; the POST /api/deals
/// handler does `UPDATE ... SET next = next + 1 RETURNING next` atomically.
model DealNumberSequence {
  year Int @id
  next Int @default(1)

  @@map("deal_number_sequence")
}

// =============================================================================
// MONETIZATION (ПромМаркет)
//
// Six offline-billed monetization models. No online card payments: vendors pay
// by bank transfer against an issued Invoice, and an admin manually confirms
// receipt. Money crosses the wire as Decimal strings (decimalStringSchema in
// contracts) and every amount lives as @db.Decimal to stay exact.
//
//   1. Subscriptions     — SubscriptionPlan + VendorSubscription
//   2. Lead credits      — LeadCreditLedger (append-only; balance = SUM(delta))
//   3. Featured listings — FeaturedPlacement + Product.featuredUntil
//   4. Verification      — VerificationRequest + VerificationDocument (+ Vendor tier)
//   5. Broker success-fee— BrokerFeeLedger (accrued on deal completion)
//   6. SaaS add-ons      — VendorAddOn
//
// Invoices are the shared settlement surface for 1, 2, 3, 5, 6. One invoice
// confirmation endpoint fans out side-effects based on invoice.type.
// =============================================================================

// --- INVOICES (shared settlement surface) ---

/// A payable document issued to a vendor or broker. status moves
/// draft → issued → paid (or overdue / cancelled). Confirmation is manual
/// (an admin records receipt after a bank transfer), never automated from a
/// payment provider, because the platform does not process cards.
model Invoice {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Human-readable, e.g. INV-2026-0001. Atomically allocated by InvoiceNumberSequence.
  number           String        @unique(map: "invoices_number_key")
  type             InvoiceType
  /// Who owes the money. payerUserId is always set; vendorId is set when the payer
  /// is a vendor so the invoice can be listed from the vendor cabinet.
  payerType        InvoicePayerType
  payerUserId      String        @map("payer_user_id") @db.Uuid
  vendorId         String?       @map("vendor_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  dealId           String?       @map("deal_id") @db.Uuid
  amount           Decimal       @db.Decimal(16, 2)
  currency         String        @default("RUB")
  status           InvoiceStatus @default(draft)
  dueDate          DateTime?     @map("due_date")
  issuedAt         DateTime?     @map("issued_at")
  paidAt           DateTime?     @map("paid_at")
  /// Free-text reference the payer supplies (payment order number, date, bank).
  paymentReference String?       @map("payment_reference")
  /// Admin who confirmed receipt.
  confirmedBy      String?       @map("confirmed_by") @db.Uuid
  confirmer        User?         @relation("InvoiceConfirmer", fields: [confirmedBy], references: [id], map: "invoices_confirmed_by_fkey")
  confirmedAt      DateTime?     @map("confirmed_at")
  notes            String?
  /// Line items as a JSON array of { description, quantity, unitPrice, total }.
  items            Json
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  subscription     VendorSubscription? @relation("SubscriptionInvoice")
  deal             Deal?         @relation(fields: [dealId], references: [id], map: "invoices_deal_id_fkey")
  vendor           Vendor?       @relation(fields: [vendorId], references: [id], map: "invoices_vendor_id_fkey")
  featuredPlacements FeaturedPlacement[]
  brokerFees       BrokerFeeLedger[]
  addOns           VendorAddOn[]

  @@index([payerUserId], map: "invoices_payer_user_id_idx")
  @@index([vendorId], map: "invoices_vendor_id_idx")
  @@index([status], map: "invoices_status_idx")
  @@index([type], map: "invoices_type_idx")
  @@map("invoices")
}

enum InvoiceType {
  subscription
  lead_credits
  featured
  broker_fee
  add_on

  @@map("invoice_type")
}

enum InvoicePayerType {
  vendor
  broker

  @@map("invoice_payer_type")
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  cancelled

  @@map("invoice_status")
}

/// Monotonic counter for invoice numbers, mirroring DealNumberSequence.
/// One row per year; the billing module does
/// `UPDATE ... SET next = next + 1 RETURNING next` atomically inside the
/// transaction that creates the invoice.
model InvoiceNumberSequence {
  year Int @id
  next Int @default(1)

  @@map("invoice_number_sequence")
}

// --- 1. SUBSCRIPTIONS ---

/// A vendor-facing tariff. Plans are admin-managed reference data; vendors pick
/// one and a VendorSubscription row records the choice and its payment lifecycle.
model SubscriptionPlan {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable code for lookups and feature flags, e.g. "pro_yearly".
  code                String             @unique(map: "subscription_plans_code_key")
  name                String
  description         String?
  price               Decimal            @db.Decimal(16, 2)
  currency            String             @default("RUB")
  billingPeriod       SubscriptionPeriod
  /// Caps that gate the vendor's catalog. Null means unlimited.
  maxProducts         Int?               @map("max_products")
  maxRegions          Int?               @map("max_regions")
  /// Credits granted on each renewal; added to the lead credit ledger when the
  /// subscription invoice is confirmed.
  includedLeadCredits Int                @default(0) @map("included_lead_credits")
  hasFeatured         Boolean            @default(false) @map("has_featured")
  hasPrioritySupport  Boolean            @default(false) @map("has_priority_support")
  isActive            Boolean            @default(true) @map("is_active")
  sortOrder           Int                @default(0) @map("sort_order")
  subscriptions       VendorSubscription[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([isActive, sortOrder], map: "subscription_plans_is_active_sort_order_idx")
  @@map("subscription_plans")
}

enum SubscriptionPeriod {
  monthly
  quarterly
  yearly

  @@map("subscription_period")
}

/// A vendor's active or pending subscription. status moves
/// pending_payment → active → (past_due | cancelled | expired). Exactly one
/// non-terminal subscription per vendor is enforced by a partial unique index
/// in the migration (the @@unique below covers the common single-active case).
model VendorSubscription {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId         String               @map("vendor_id") @db.Uuid
  planId           String               @map("plan_id") @db.Uuid
  status           VendorSubscriptionStatus @default(pending_payment)
  periodStart      DateTime             @map("period_start")
  periodEnd        DateTime?            @map("period_end")
  /// Amount actually owed for this period (snapshot of plan.price at purchase).
  amount           Decimal              @db.Decimal(16, 2)
  currency         String               @default("RUB")
  /// Reference to the issued invoice awaiting or recording payment.
  invoiceId        String?              @unique(map: "vendor_subscriptions_invoice_id_key") @map("invoice_id") @db.Uuid
  invoice          Invoice?             @relation("SubscriptionInvoice", fields: [invoiceId], references: [id], map: "vendor_subscriptions_invoice_id_fkey")
  confirmedBy      String?              @map("confirmed_by") @db.Uuid
  confirmedAt      DateTime?            @map("confirmed_at")
  cancelledAt      DateTime?            @map("cancelled_at")
  vendor           Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "vendor_subscriptions_vendor_id_fkey")
  plan             SubscriptionPlan     @relation(fields: [planId], references: [id], map: "vendor_subscriptions_plan_id_fkey")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([vendorId], map: "vendor_subscriptions_vendor_id_idx")
  @@index([status], map: "vendor_subscriptions_status_idx")
  @@map("vendor_subscriptions")
}

enum VendorSubscriptionStatus {
  pending_payment
  active
  past_due
  cancelled
  expired

  @@map("vendor_subscription_status")
}

// --- 2. LEAD CREDITS ---

/// Append-only ledger. The balance is SUM(delta) WHERE vendor_id = ?; there is
/// no separate balance column to keep it race-free. Writes happen inside a
/// Postgres advisory lock keyed on the vendor so two concurrent unlocks cannot
/// both succeed against a single remaining credit.
model LeadCreditLedger {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId    String             @map("vendor_id") @db.Uuid
  /// Signed: positive on purchase/grant/reset, negative on spend.
  delta       Int
  reason      LeadCreditReason
  /// Optional reference: invoiceId on purchase, dealId/RFQ id on unlock.
  referenceId String?            @map("reference_id")
  /// Snapshot of the running balance after this row, for fast display without
  /// a full SUM. Maintained inside the same locked transaction as the delta.
  balanceAfter Int              @map("balance_after")
  vendor       Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "lead_credit_ledger_vendor_id_fkey")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([vendorId, createdAt], map: "lead_credit_ledger_vendor_id_created_at_idx")
  @@index([reason], map: "lead_credit_ledger_reason_idx")
  @@map("lead_credit_ledger")
}

enum LeadCreditReason {
  purchase
  admin_grant
  rfq_unlock
  monthly_reset
  refund
  subscription_grant

  @@map("lead_credit_reason")
}

// --- 3. FEATURED PLACEMENTS ---

/// A paid boost for a product in a specific surface for a time window. Created
/// pending; activated when the invoice is confirmed. Product.featuredUntil is
/// the denormalized "latest active boost end" used by the catalog query.
model FeaturedPlacement {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId   String              @map("product_id") @db.Uuid
  vendorId    String              @map("vendor_id") @db.Uuid
  placement   FeaturedSurface
  startAt     DateTime            @map("start_at")
  endAt       DateTime            @map("end_at")
  status      FeaturedStatus      @default(pending)
  invoiceId   String?             @map("invoice_id") @db.Uuid
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], map: "featured_placements_invoice_id_fkey")
  product     Product             @relation(fields: [productId], references: [id], map: "featured_placements_product_id_fkey")
  vendor      Vendor              @relation(fields: [vendorId], references: [id], map: "featured_placements_vendor_id_fkey")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([productId], map: "featured_placements_product_id_idx")
  @@index([status, endAt], map: "featured_placements_status_end_at_idx")
  @@index([placement, status], map: "featured_placements_placement_status_idx")
  @@map("featured_placements")
}

enum FeaturedSurface {
  category_top
  home_featured
  search_boost

  @@map("featured_surface")
}

enum FeaturedStatus {
  pending
  active
  expired
  cancelled

  @@map("featured_status")
}

// --- 4. VERIFICATION ---

/// A vendor's request to be verified. status moves
/// draft → submitted → under_review → (approved | rejected). approved sets
/// Vendor.verificationTier and Vendor.verified; revoked returns them to none.
model VerificationRequest {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId       String                 @map("vendor_id") @db.Uuid
  status         VerificationStatus     @default(draft)
  /// Tier the vendor is applying for; granted on approval.
  requestedTier  VerificationTier       @default(basic) @map("requested_tier")
  contactName    String?                @map("contact_name")
  contactPhone   String?                @map("contact_phone")
  message        String?
  submittedAt    DateTime?              @map("submitted_at")
  /// Moderator who is reviewing or has reviewed.
  reviewedBy     String?                @map("reviewed_by") @db.Uuid
  reviewer       User?                  @relation("VerificationReviewer", fields: [reviewedBy], references: [id], map: "verification_requests_reviewed_by_fkey")
  reviewedAt     DateTime?              @map("reviewed_at")
  reviewerNotes  String?                @map("reviewer_notes")
  /// When the granted tier expires. Maintained on approval; a cron job can
  /// downgrade the vendor when this passes.
  expiresAt      DateTime?              @map("expires_at")
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "verification_requests_vendor_id_fkey")
  documents      VerificationDocument[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([status], map: "verification_requests_status_idx")
  @@index([vendorId], map: "verification_requests_vendor_id_idx")
  @@map("verification_requests")
}

enum VerificationStatus {
  draft
  submitted
  under_review
  approved
  rejected
  revoked

  @@map("verification_status")
}

/// A document attached to a verification request. objectKey points at the
/// private storage upload (see docs/STORAGE.md upload contract).
model VerificationDocument {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  documentType         VerificationDocumentType
  fileName             String              @map("file_name")
  /// Backend-generated storage object key. The upload follows the same
  /// ticket/upload/finalize contract as avatars; PDF is allowed in addition
  /// to images because certificates and licenses are usually PDF.
  objectKey            String              @map("object_key")
  contentType          String              @map("content_type")
  byteSize             Int                 @map("byte_size")
  verificationRequest  VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade, map: "verification_documents_verification_request_id_fkey")
  uploadedAt           DateTime            @default(now()) @map("uploaded_at")

  @@index([verificationRequestId], map: "verification_documents_verification_request_id_idx")
  @@map("verification_documents")
}

enum VerificationDocumentType {
  inn
  ogrn
  license
  iso_certificate
  company_registration
  other

  @@map("verification_document_type")
}

// --- 5. BROKER SUCCESS-FEE ---

/// One row per closed deal that earns a broker commission. Accrued when the
/// deal transitions connection → completed; invoiced and paid later through
/// the shared Invoice table. Deal.commission is the denormalized snapshot.
model BrokerFeeLedger {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dealId      String           @map("deal_id") @db.Uuid
  brokerId    String           @map("broker_id") @db.Uuid
  /// The deal total the percent is computed against.
  baseAmount  Decimal          @db.Decimal(16, 2)
  feePercent  Decimal          @db.Decimal(5, 2)
  feeAmount   Decimal          @db.Decimal(16, 2)
  status      BrokerFeeStatus  @default(accrued)
  invoiceId   String?          @map("invoice_id") @db.Uuid
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], map: "broker_fee_ledger_invoice_id_fkey")
  accruedAt   DateTime         @default(now()) @map("accrued_at")
  paidAt      DateTime?        @map("paid_at")
  notes       String?
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade, map: "broker_fee_ledger_deal_id_fkey")
  broker      User             @relation(fields: [brokerId], references: [id], map: "broker_fee_ledger_broker_id_fkey")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([brokerId, status], map: "broker_fee_ledger_broker_id_status_idx")
  @@index([dealId], map: "broker_fee_ledger_deal_id_idx")
  @@index([status], map: "broker_fee_ledger_status_idx")
  @@map("broker_fee_ledger")
}

enum BrokerFeeStatus {
  accrued
  invoiced
  paid
  written_off

  @@map("broker_fee_status")
}

// --- 6. SaaS ADD-ONS ---

/// A vendor's access to an add-on feature (CRM, analytics, API, tenders).
/// Activated pending invoice confirmation, like subscriptions.
model VendorAddOn {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId    String          @map("vendor_id") @db.Uuid
  feature     VendorAddOnFeature
  status      VendorAddOnStatus @default(pending)
  activatedAt DateTime?        @map("activated_at")
  expiresAt   DateTime?        @map("expires_at")
  invoiceId   String?          @map("invoice_id") @db.Uuid
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], map: "vendor_add_ons_invoice_id_fkey")
  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "vendor_add_ons_vendor_id_fkey")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([vendorId, feature], map: "vendor_add_ons_vendor_id_feature_idx")
  @@index([status], map: "vendor_add_ons_status_idx")
  @@map("vendor_add_ons")
}

enum VendorAddOnFeature {
  crm
  analytics
  api_access
  tenders

  @@map("vendor_add_on_feature")
}

enum VendorAddOnStatus {
  pending
  active
  disabled
  expired

  @@map("vendor_add_on_status")
}

// =============================================================================
// REVIEWS + NOTIFICATIONS (ПромМаркет iteration 7)
//
// Product reviews: a buyer who closed a deal on a product can leave one review.
// Notifications: server-pushed events surfaced in the webapp cabinet; the WS
// layer (deal chat) can broadcast these in real time later, but the table is
// the source of truth and works without WS.
// =============================================================================

/// One review per (product, author). A buyer rates a product after a deal.
model ProductReview {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// The user who wrote the review.
  authorId  String   @map("author_id") @db.Uuid
  rating    Int
  title     String?
  body      String?
  /// A vendor may reply once; stored inline to keep the review self-contained.
  vendorReply String? @map("vendor_reply")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_reviews_product_id_fkey")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "product_reviews_author_id_fkey")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, authorId], map: "product_reviews_product_id_author_id_key")
  @@index([productId], map: "product_reviews_product_id_idx")
  @@index([authorId], map: "product_reviews_author_id_idx")
  @@map("product_reviews")
}

/// In-app notification for a user (deal event, verification result, etc.).
/// Read via GET /api/notifications; marked read via PATCH.
model Notification {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  /// Optional link to navigate to when clicked.
  link      String?  @map("link")
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "notifications_user_id_fkey")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead], map: "notifications_user_id_is_read_idx")
  @@index([userId, createdAt], map: "notifications_user_id_created_at_idx")
  @@map("notifications")
}
